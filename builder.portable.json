{
  "appId": "com.mull.app",
  "productName": "Mull",
  "directories": {
    "buildResources": "build",
    "output": "dist"
  },
  "asarUnpack": [
    "node_modules/node-llama-cpp/**",
    "node_modules/@node-llama-cpp/**",
    "node_modules/@fugood/**",
    "node_modules/pdfjs-dist/**"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png"
  },
  "npmRebuild": false,
  "files": [
    "*.js",
    "index.html",
    "styles.css",
    "vendor/**/*",
    "build/icon.png",
    "!builder*.json",
    "!**/node_modules/@node-llama-cpp/win-arm64/**",
    "!**/node_modules/@fugood/node-whisper-wasm/**",
    "!**/node_modules/@fugood/node-whisper-win32-x64-cuda/**",
    "!**/node_modules/@fugood/node-whisper-win32-x64-vulkan/**",
    "!**/node_modules/pdfjs-dist/web/**",
    "!**/node_modules/pdfjs-dist/types/**",
    "!**/node_modules/pdfjs-dist/build/**",
    "!**/node_modules/@node-llama-cpp/win-x64-cuda/**",
    "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**"
  ],
  "portable": {
    "artifactName": "Mull-Portable-${version}.exe"
  }
}
